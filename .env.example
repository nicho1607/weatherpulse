# PostgreSQL (Neon) — connection string with connection pooling (pgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
# Direct connection (used by Prisma Migrate), bypasses the pooler
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js v5 — generate with `npx auth secret`
AUTH_SECRET=""

# GitHub OAuth App credentials
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
